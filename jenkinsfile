pipeline{
    agent any

    environment{
        APP_NAME="pingpong"
        DOCKER_IMAGE="$APP_NAME:v$BUILD_NUMBER"
        CONTAINER_NAME="yabadabadoo"
        TEST_REPO=" https://github.com/devops-org-hodi/jenkins-demo1-test.git"
        TEST_DIR="jenkins-demo1-test"
    }

    stages{
        stage("build"){
            steps{
                echo "========= building docker images ========="
                sh 'docker ps'
                sh """docker build \
                      -t $DOCKER_IMAGE \
                      ./src/ 
                   """
            }
            post{
                success{
                    sh "docker images | grep -i $APP_NAME "
                }
            }
        }
        stage("prepare application for testing"){
            steps{
                sh "docker run -d -p 5000:5000 --name $CONTAINER_NAME $DOCKER_IMAGE"
                sh "git clone $TEST_REPO "
            }
            post{
                always{
                    sh 'docker ps '
                    sh "docker logs $CONTAINER_NAME"
                }
            }
        }
        stage("test"){
            parallel{
                stage("e2e test"){
                    steps{
                        dir("$TEST_DIR/e2e") {
                            sh " chmod 777 test.sh"
                            sh " ./test.sh"
                        }
                    }
                }
                stage("regression test"){
                    steps{
                        dir("$TEST_DIR/regression") {
                            sh "python3 test.py"
                        }
                    }
                }
                stage("sanity test"){
                    steps{
                        sh 'curl 127.0.0.1:5000/ping'
                    }
                }
            }        
        }
        stage("push to dockerhub "){
            steps{
                sh 'echo hello'
            }
        }
        stage("validate"){
            steps{
                sh 'echo hello'
            }
        }
    }
    post{
        always{ 
            sh "docker rm -f $CONTAINER_NAME"
            cleanWs()
            sh "docker rmi  $DOCKER_IMAGE "
         }
        success{
            echo 'pipeline finished .... '
        }
        failure{
            echo 'check your code man - if its not working put the laptop in the freezer '
        }
    }
}


