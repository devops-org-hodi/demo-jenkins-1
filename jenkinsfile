pipeline{
    agent any

    environment{
        APP_NAME="PINGPONG"
        DOCKER_IMAGE="$APP_NAME:V$BUILD_NUMBER"
    }

    stages{
        stage("build"){
            steps{
                echo "========= building docker images ========="
                sh 'docker ps'
                sh "docker build -t $DOCKER_IMAGE ./src/ "
            }
        }
        stage("test"){
            steps{
                sh 'echo hello'
            }
        }        
        stage("push to dockerhub "){
            steps{
                sh 'echo hello'
            }
        }
        stage("validate"){
            steps{
                sh 'echo hello'
            }
        }
    }
    post{
        always{ 
            cleanWs()
         }
        success{
            echo 'pipeline finished .... '
        }
        failure{
            echo 'check your code man - if its not working put the laptop in the freezer '
        }
    }
}