pipeline{
    agent any

    environment{
        APP_NAME="pingpong"
        DOCKER_IMAGE="hothaifaz11/jenkins-demo-shemo-hemo:v$BUILD_NUMBER"
        CONTAINER_NAME="yabadabadoo"
        TEST_REPO=" https://github.com/devops-org-hodi/jenkins-demo1-test.git"
        TEST_DIR="jenkins-demo1-test"
    }

    stages{
        stage("build"){
            steps{
                echo "========= building docker images ========="
                sh 'docker ps'
                sh """docker build \
                      -t $DOCKER_IMAGE \
                      ./src/ 
                   """
            }
            post{
                success{
                    sh "docker images | grep -i $APP_NAME "
                }
            }
        }
        stage("prepare application for testing"){
            steps{
                sh "docker run -d -p 5000:5000 --name $CONTAINER_NAME $DOCKER_IMAGE"
                sh "git clone $TEST_REPO "
            }
            post{
                always{
                    sh 'docker ps '
                    sh "docker logs $CONTAINER_NAME"
                }
            }
        }
        stage("test"){
            parallel{
                stage("e2e test"){
                    steps{
                        dir("$TEST_DIR/e2e") {
                            sh " chmod 777 test.sh"
                            sh " ./test.sh"
                        }
                    }
                }
                stage("regression test"){
                    steps{
                        dir("$TEST_DIR/regression") {
                            sh "python3 test.py"
                        }
                    }
                }
                stage("sanity test"){
                    steps{
                        sh 'curl 127.0.0.1:5000/ping'
                    }
                }
            }        
        }
        stage("push to dockerhub "){
            steps{
                withCredentials([usernamePassword(
                    credentialsId: 'docker-cred', 
                    usernameVariable: 'USERNAME', 
                    passwordVariable: 'PASS'
                )]) {
                    sh """ echo $PASS | docker login --username $USERNAME --password-stdin """
                    sh "docker push $DOCKER_IMAGE"
                }
            }
        }
        stage("upate manifest"){
            steps{
                echo "clone the deploy repo"
                 withCredentials([usernamePassword(
                    credentialsId: 'github-cred', 
                    usernameVariable: 'USERNAME', 
                    passwordVariable: 'PASS'
                )]){
                        sh " git clone https://$USERNAME:$PASS@github.com/devops-org-hodi/flask-app-deployment"
                        dir("flask-app-deployment/k8s"){
                            sh """
                            sed -i "s/image:.*/image: $DOCKER_IMAGE/g" manifest.yaml
                            git config user.name jenkins
                            git config user.email jenkins@jenkins.jenkins
                            git add manifest.yaml
                            git commit -m "jenkins: build $BUILD_NUMBER of $JOB_NAME"
                            git push 
                        """
                        }
                }
            }
        }
    }
    post{
        always{ 
            sh "docker rm -f $CONTAINER_NAME"
            cleanWs()
            sh "docker rmi  $DOCKER_IMAGE "
         }
        success{
            echo 'pipeline finished .... '
        }
        failure{
            echo 'check your code man - if its not working put the laptop in the freezer '
        }
    }
}


