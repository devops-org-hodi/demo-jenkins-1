pipeline{
    agent any

    stages{
        stage("build"){
            steps{
                sh 'ls'
                sh 'date > file1.txt'
            }
        }
        stage("test"){
            steps{
                sh 'echo hello'
            }
        }        
        stage("push to dockerhub "){
            steps{
                sh 'echo hello'
            }
        }
        stage("validate"){
            steps{
                sh 'echo hello'
            }
        }
    }
    post{
        always{ 
            cleanWs()
         }
        success{
            echo 'pipeline finished .... '
        }
        failure{
            echo 'check your code man - if its not working put the laptop in the freezer '
        }
    }
}